# ============================================================================
# CLAW ROYALE BOT v6.1 - ENVIRONMENT VARIABLES
# ============================================================================
# Copy this file to .env and adjust values as needed
# ============================================================================


# ============================================================================
# REQUIRED - WAJIB DIISI
# ============================================================================

# Claw Royale API Key - WAJIB
# Dapatkan dari dashboard Claw Royale setelah login
# Format: mr_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLAW_API_KEY=mr_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ============================================================================
# STRATEGY MODE - Pilih strategi bot
# ============================================================================

# Pilih salah satu strategy mode:
# 
# 'hybrid'     - 🤖 Hybrid AI + Reinforcement Learning (Default, Recommended)
#                - Adaptive decision making
#                - Belajar dari pengalaman
#                - Paling cerdas tapi lebih kompleks
#
# 'scan_clear' - 📋 Scan & Clear
#                - Ambil SEMUA item di region
#                - Bunuh SEMUA musuh yang bisa dikill
#                - Pindah ke region berikutnya
#                - Cepat dan agresif
#
STRATEGY_MODE=scan_clear


# ============================================================================
# GAME CONFIGURATION
# ============================================================================

# Entry type: free atau paid
# - free: Masuk ke free room (gratis)
# - paid: Masuk ke paid room (membutuhkan sMoltz)
ENTRY_TYPE=free

# Preferred mode untuk paid games: offchain atau onchain
# - offchain: Transaksi off-chain (lebih cepat)
# - onchain: Transaksi on-chain (lebih aman)
PREFERRED_MODE=offchain

# Action interval in seconds
# Jarak antar action yang dikirim ke server
# Nilai: 0.1 - 1.0 (recommended: 0.25)
# Terlalu cepat → rate limit, terlalu lambat → kurang responsif
ACTION_INTERVAL_SECONDS=0.25


# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR
# - DEBUG: Semua log termasuk detail internal (untuk debugging)
# - INFO: Log normal (recommended untuk production)
# - WARNING: Hanya peringatan dan error
# - ERROR: Hanya error
LOG_LEVEL=INFO

# Log format: (default, tidak perlu diubah)
# LOG_FORMAT=%(asctime)s | %(levelname)-8s | %(name)-15s | %(message)s


# ============================================================================
# REINFORCEMENT LEARNING (RL) CONFIGURATION
# ============================================================================

# Enable/disable Reinforcement Learning
# - true: Bot akan belajar dari pengalaman (recommended)
# - false: Bot hanya pakai heuristic, tidak belajar
RL_ENABLED=true

# Learning rate (0.01 - 1.0)
# Seberapa cepat bot belajar dari pengalaman baru
# - Higher: Belajar cepat tapi bisa lupa yang lama
# - Lower: Belajar lambat tapi lebih stabil
RL_LEARNING_RATE=0.1

# Initial exploration rate (0.0 - 1.0)
# Seberapa sering bot mencoba hal baru di awal
# - 1.0: Selalu eksplorasi (awal)
# - 0.0: Tidak pernah eksplorasi
RL_EPSILON_START=1.0

# Final exploration rate (0.0 - 1.0)
# Seberapa sering bot mencoba hal baru setelah belajar
# - 0.05: 5% eksplorasi (recommended)
RL_EPSILON_END=0.05


# ============================================================================
# MEMORY CONFIGURATION
# ============================================================================

# Maximum knowledge history entries
# Berapa banyak history yang disimpan untuk pembelajaran
# - 500: Recommended untuk memory terbatas
# - 1000: Untuk bot yang jalan lama
MAX_KNOWLEDGE_HISTORY=500

# Maximum RL memory size
# Berapa banyak pengalaman RL yang disimpan
MAX_RL_MEMORY=1000


# ============================================================================
# PERFORMANCE & TIMEOUT (Advanced)
# ============================================================================

# Minimum action interval (seconds)
# Jangan diubah kecuali paham konsekuensinya
# ACTION_INTERVAL_MIN=0.1

# Maximum retry delay (seconds)
# Maksimum waktu tunggu saat retry koneksi
# MAX_RETRY_DELAY=30

# View timeout (seconds)
# Berapa lama menunggu view sebelum rejoin
# VIEW_TIMEOUT=90

# Stuck detection turns
# Berapa turn tanpa perubahan sebelum dianggap stuck
# STUCK_TURNS=10


# ============================================================================
# RUIN & ALERT CONFIGURATION
# ============================================================================

# Alert threshold untuk berhenti explore
# Jika alert > threshold, bot akan berhenti explore
# ALERT_THRESHOLD=7

# Max gauge per ruin
# MAX_RUIN_GAUGE=3


# ============================================================================
# ITEM & LOOT CONFIGURATION
# ============================================================================

# Max distance untuk pickup item
# ITEM_PICKUP_DISTANCE=5.0

# Max item per scan
# MAX_ITEMS_PER_SCAN=15

# Prioritaskan healing items
# HEALING_PRIORITY=true


# ============================================================================
# HEALTH SERVER (Monitoring)
# ============================================================================

# Port untuk health server
# HEALTH_PORT=8080

# Enable dashboard
# DASHBOARD_ENABLED=true


# ============================================================================
# ADVANCED - JANGAN DIUBAH KECUALI PAHAM
# ============================================================================

# API Base URL (default: Claw Royale API)
# BASE_API=https://cdn.clawroyale.ai/api

# WebSocket URL (default)
# JOIN_WS=wss://cdn.clawroyale.ai/ws/join

# Agent WebSocket URL
# AGENT_WS=wss://cdn.clawroyale.ai/ws/agent


# ============================================================================
# DEBUGGING (Hanya untuk development)
# ============================================================================

# Enable debug mode (lebih banyak log)
# DEBUG=false

# Print config on startup
# PRINT_CONFIG=true

# Save raw messages (untuk debugging)
# SAVE_RAW_MESSAGES=false


# ============================================================================
# CONTOH KOMBINASI STRATEGY
# ============================================================================

# ===== MODE 1: HYBRID AI + RL (Recommended untuk pemula) =====
# STRATEGY_MODE=hybrid
# RL_ENABLED=true
# LOG_LEVEL=INFO

# ===== MODE 2: SCAN & CLEAR (Agresif) =====
# STRATEGY_MODE=scan_clear
# LOG_LEVEL=INFO
# ACTION_INTERVAL_SECONDS=0.2

# ===== MODE 3: HYBRID AI tanpa RL (Stabil) =====
# STRATEGY_MODE=hybrid
# RL_ENABLED=false
# LOG_LEVEL=INFO

# ===== MODE 4: DEBUG (Untuk troubleshooting) =====
# STRATEGY_MODE=hybrid
# LOG_LEVEL=DEBUG
# RL_ENABLED=false


# ============================================================================
# CATATAN PENTING
# ============================================================================

# 1. CLAW_API_KEY adalah satu-satunya variabel WAJIB
# 2. STRATEGY_MODE menentukan cara bot berpikir
# 3. RL_ENABLED mempengaruhi kemampuan belajar bot
# 4. LOG_LEVEL mempengaruhi detail log yang terlihat
# 5. Jangan ubah nilai di bagian ADVANCED kecuali paham
# 6. Untuk performance terbaik, gunakan STRATEGY_MODE=hybrid
# 7. Untuk agresif farming, gunakan STRATEGY_MODE=scan_clear

# ============================================================================

# Entry type: free or paid
ENTRY_TYPE=free

# Preferred mode for paid games: offchain or onchain
PREFERRED_MODE=offchain

# Action interval in seconds (0.1 - 1.0 recommended)
ACTION_INTERVAL_SECONDS=0.1

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# AI Configuration
AI_ENABLED=true
AI_LEARNING_RATE=0.1
